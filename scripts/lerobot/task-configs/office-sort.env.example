# 办公桌物品三分类任务。复制为不带 .example 的本地文件后，只填写真实硬件路径。
FMS688_DATA="$HOME/fms688_data"
DATASET_NAMESPACE="fms688"

TASK_SLUG="sort_office_items"
TASK_DESCRIPTION="Sort the specified office item into its registered category zone."
DATASET_VERSION="v001"
ROUND_ID="r01"

# r01=7（七种物品各一条冒烟）；r02-r06=70（当前起点格内每种物品十条）。
EPISODES_THIS_ROUND="7"
EPISODE_MAX_TIME_S="300"
RESET_MAX_TIME_S="120"
FPS="30"

FOLLOWER_PORT="/dev/serial/by-id/<FOLLOWER_BUS_ID>"
LEADER_PORT="/dev/serial/by-id/<LEADER_BUS_ID>"
FOLLOWER_ID="so101_follower_rack_01"
LEADER_ID="so101_leader_rack_01"
TOP_CAMERA="/dev/video<TOP_INDEX>"
TOP_FOURCC="MJPG"
WRIST_CAMERA="/dev/video<WRIST_INDEX>"
WRIST_FOURCC="MJPG"
TOP_WIDTH="640"
TOP_HEIGHT="480"
WRIST_WIDTH="640"
WRIST_HEIGHT="480"

NUM_WORKERS="4"
SAVE_FREQ="20000"
EVAL_STEPS="0"

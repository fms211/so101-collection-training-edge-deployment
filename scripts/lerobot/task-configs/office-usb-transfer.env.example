# USB-A 线头转运任务。复制为不带 .example 的本地文件后，只填写真实硬件路径。
FMS688_DATA="$HOME/fms688_data"
DATASET_NAMESPACE="fms688"

TASK_SLUG="transfer_usb_a_to_preinsert"
TASK_DESCRIPTION="Pick up the USB-A connector from the U-shaped holder and place it in the pre-insertion cradle."
DATASET_VERSION="v001"
ROUND_ID="r01"

# r01=5（冒烟）；r02=45（固定卡槽与预对准托位），合计50条。
EPISODES_THIS_ROUND="5"
EPISODE_MAX_TIME_S="300"
RESET_MAX_TIME_S="120"
FPS="30"

FOLLOWER_PORT="/dev/serial/by-id/<FOLLOWER_BUS_ID>"
LEADER_PORT="/dev/serial/by-id/<LEADER_BUS_ID>"
FOLLOWER_ID="so101_follower_rack_01"
LEADER_ID="so101_leader_rack_01"
TOP_CAMERA="/dev/video<TOP_INDEX>"
TOP_FOURCC="MJPG"
WRIST_CAMERA="/dev/video<WRIST_INDEX>"
WRIST_FOURCC="MJPG"
TOP_WIDTH="640"
TOP_HEIGHT="480"
WRIST_WIDTH="640"
WRIST_HEIGHT="480"

NUM_WORKERS="4"
SAVE_FREQ="20000"
EVAL_STEPS="0"

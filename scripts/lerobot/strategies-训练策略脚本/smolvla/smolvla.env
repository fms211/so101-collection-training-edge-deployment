# SmolVLA 专属微调参数。公共任务、数据、相机与硬件配置在 ../../fms688.env。
POLICY_NAME="smolvla"
SMOLVLA_POLICY_PATH="lerobot/smolvla_base"
SMOLVLA_VLM_MODEL_NAME="HuggingFaceTB/SmolVLM2-500M-Video-Instruct"

SMOLVLA_SMOKE_BATCH_SIZE="2"
SMOLVLA_SMOKE_STEPS="100"
SMOLVLA_FORMAL_BATCH_SIZE="8"
SMOLVLA_FORMAL_STEPS="20000"
SMOLVLA_FOUR_GPU_BATCH_SIZE="8"
SMOLVLA_FOUR_GPU_STEPS="5000"

SMOLVLA_CHUNK_SIZE="50"
SMOLVLA_N_ACTION_STEPS="50"
SMOLVLA_NUM_STEPS="10"
SMOLVLA_FREEZE_VISION_ENCODER="true"
SMOLVLA_TRAIN_EXPERT_ONLY="true"
SMOLVLA_TRAIN_STATE_PROJ="true"
SMOLVLA_LOAD_VLM_WEIGHTS="true"
SMOLVLA_OPTIMIZER_LR="1e-4"
SMOLVLA_OPTIMIZER_WEIGHT_DECAY="1e-10"
SMOLVLA_SCHEDULER_WARMUP_STEPS="1000"
SMOLVLA_SCHEDULER_DECAY_STEPS="30000"
SMOLVLA_SCHEDULER_DECAY_LR="2.5e-6"

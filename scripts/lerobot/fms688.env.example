# 复制为 fms688.env 后修改；不要在此文件或 Git 中写入密码、Token、API Key。

# 当前机器的数据根目录。方案B中轻薄本是采集原件，服务器同路径是训练副本。
FMS688_DATA="$HOME/fms688_data"
# 本项目的数据读取缓存；与数据根目录放在同一磁盘。
HF_DATASETS_CACHE="$FMS688_DATA/cache/hf_datasets"
# LeRobot 的逻辑数据集命名空间；本地不上传时只用于标识。
DATASET_NAMESPACE="fms688"
# 可选；不填时按命名空间、任务和版本推导。不同任务/版本不要共用同一仓库。
HF_REPO_ID=""
CALIBRATION_ROOT="$FMS688_DATA/calibration"
# 图像特征嵌入 Parquet，比 MP4 占空间更多。10 GB 只是预检下限；首轮测实际体积后按每轮集数提高。
MIN_FREE_GB="10"

# 任务和数据定义。改任务/物体/相机布局/字段时升级 DATASET_VERSION。
TASK_SLUG="move_blue_cube"
TASK_DESCRIPTION="Move the blue cube to the registered target area."
DATASET_VERSION="v001"
# 当前人类组织的采集批次；每次新一轮改成 r01、r02、r03。
ROUND_ID="r01"

# 一轮中要保留多少条完整示教轨迹；这是 episode 数，不是轮次编号。
EPISODES_THIS_ROUND="5"
# 日常由键盘决定何时结束示教/复位；这两个值只是防遗忘的硬上限，不是建议的自动切换时间。
# 到达上限时 LeRobot 仍会自动切换，因此保持较长并始终在交互式 SSH 终端中按 n/r/q 操作。
EPISODE_MAX_TIME_S="300"
RESET_MAX_TIME_S="120"
FPS="30"
# 跟随/录制时，每个控制周期目标相对从臂实时位置的最大差值（度）；不是速度上限。
# 调小更安全但跟随更滞后；调大更灵敏但风险更高。不要留空。
MAX_RELATIVE_TARGET="1.0"

# 已经通过端口检查和校准的硬件路径/身份。方案B仅轻薄本会访问这些路径。
# 服务器训练配置保留同一任务/版本，但不得向同一版本运行采集追加。
FOLLOWER_PORT="/dev/serial/by-id/<FOLLOWER_BUS_ID>"
LEADER_PORT="/dev/serial/by-id/<LEADER_BUS_ID>"
FOLLOWER_ID="so101_follower_rack_01"
LEADER_ID="so101_leader_rack_01"
# 优先使用 /dev/v4l/by-id/<CAMERA_ID>-video-index0，而非会变化的 /dev/videoN。
# FOURCC 可留空以自动检测；已验证支持时用 MJPG 可降低双路 USB 带宽。
TOP_CAMERA="/dev/v4l/by-id/<TOP_CAMERA_ID>-video-index0"
TOP_FOURCC="MJPG"
WRIST_CAMERA="/dev/v4l/by-id/<WRIST_CAMERA_ID>-video-index0"
WRIST_FOURCC="MJPG"
TOP_WIDTH="640"
TOP_HEIGHT="480"
WRIST_WIDTH="640"
WRIST_HEIGHT="480"

# 通用训练运行参数。ACT、SmolVLA、VQ-BeT的专属参数分别位于strategies-训练策略脚本/<policy>/<policy>.env。
NUM_WORKERS="4"
SAVE_FREQ="20000"
EVAL_STEPS="0"
